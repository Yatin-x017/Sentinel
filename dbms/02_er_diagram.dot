digraph Sentinel_ER_Diagram {
    graph [
        rankdir=LR
        pad="0.4"
        nodesep="0.55"
        ranksep="0.9"
        fontname="Helvetica"
        fontsize=14
        label="Sentinel Personal Data Exposure Platform — Normalized BCNF Entity-Relationship Diagram (Team T0058)"
        labelloc="t"
        bgcolor="#F8FAFC"
    ];
    node [
        shape=plaintext
        fontname="Helvetica"
        fontsize=10
    ];
    edge [
        fontname="Helvetica"
        fontsize=10
        color="#334155"
        penwidth=1.4
    ];

    verification_sessions [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#1E293B">
            <TR><TD COLSPAN="3" BGCOLOR="#1E3A8A"><FONT COLOR="#FFFFFF"><B>verification_sessions</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>verification_session_id</B></TD><TD ALIGN="LEFT">BIGSERIAL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email_hash</TD><TD ALIGN="LEFT">CHAR(64) NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">otp_hmac</TD><TD ALIGN="LEFT">CHAR(64) NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">attempts</TD><TD ALIGN="LEFT">SMALLINT [0..5]</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">resend_count</TD><TD ALIGN="LEFT">SMALLINT [0..3]</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">last_sent_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">verified</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">session_token_hash</TD><TD ALIGN="LEFT">CHAR(64)</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        </TABLE>
    >];

    source_registry [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#1E293B">
            <TR><TD COLSPAN="3" BGCOLOR="#0F766E"><FONT COLOR="#FFFFFF"><B>source_registry</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>source_id</B></TD><TD ALIGN="LEFT">VARCHAR(64)</TD></TR>
            <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(120) NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">timeout_ms</TD><TD ALIGN="LEFT">INTEGER [&gt;=100]</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rate_limit_per_min</TD><TD ALIGN="LEFT">INTEGER [&gt;=1]</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        </TABLE>
    >];

    scan_sessions [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#1E293B">
            <TR><TD COLSPAN="3" BGCOLOR="#1D4ED8"><FONT COLOR="#FFFFFF"><B>scan_sessions</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>scan_session_id</B></TD><TD ALIGN="LEFT">BIGSERIAL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">verification_session_id</TD><TD ALIGN="LEFT">BIGINT NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">expires_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        </TABLE>
    >];

    scan_source_statuses [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#1E293B">
            <TR><TD COLSPAN="3" BGCOLOR="#334155"><FONT COLOR="#FFFFFF"><B>scan_source_statuses</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT"><B>scan_session_id</B></TD><TD ALIGN="LEFT">BIGINT</TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT"><B>source_id</B></TD><TD ALIGN="LEFT">VARCHAR(64)</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">latency_ms</TD><TD ALIGN="LEFT">INTEGER [&gt;=0]</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT">TEXT</TD></TR>
        </TABLE>
    >];

    scan_findings [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#1E293B">
            <TR><TD COLSPAN="3" BGCOLOR="#7C3AED"><FONT COLOR="#FFFFFF"><B>scan_findings</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>finding_id</B></TD><TD ALIGN="LEFT">BIGSERIAL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK,UQ</B></TD><TD ALIGN="LEFT">scan_session_id</TD><TD ALIGN="LEFT">BIGINT NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK,UQ</B></TD><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT">VARCHAR(64) NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">incident_id</TD><TD ALIGN="LEFT">VARCHAR(120) NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">identifier_type</TD><TD ALIGN="LEFT">VARCHAR(32)</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">match_type</TD><TD ALIGN="LEFT">VARCHAR(32)</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">breach_date</TD><TD ALIGN="LEFT">DATE</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">retrieved_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">confidence</TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">evidence_reference</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
        </TABLE>
    >];

    finding_exposed_fields [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#1E293B">
            <TR><TD COLSPAN="3" BGCOLOR="#9333EA"><FONT COLOR="#FFFFFF"><B>finding_exposed_fields</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK,FK</B></TD><TD ALIGN="LEFT"><B>finding_id</B></TD><TD ALIGN="LEFT">BIGINT</TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>field_name</B></TD><TD ALIGN="LEFT">VARCHAR(64)</TD></TR>
        </TABLE>
    >];

    scan_actions [label=<
        <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#1E293B">
            <TR><TD COLSPAN="3" BGCOLOR="#B45309"><FONT COLOR="#FFFFFF"><B>scan_actions</B></FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT"><B>action_id</B></TD><TD ALIGN="LEFT">BIGSERIAL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>FK,UQ</B></TD><TD ALIGN="LEFT">scan_session_id</TD><TD ALIGN="LEFT">BIGINT NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">action_code</TD><TD ALIGN="LEFT">VARCHAR(64) NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT">SMALLINT [&gt;0]</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">VARCHAR(200) NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT">TEXT NOT NULL</TD></TR>
            <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">category_trigger</TD><TD ALIGN="LEFT">VARCHAR(64) NOT NULL</TD></TR>
        </TABLE>
    >];

    verification_sessions -> scan_sessions [label="1 : N (ON DELETE CASCADE)"];
    scan_sessions -> scan_source_statuses [label="1 : N (ON DELETE CASCADE)"];
    source_registry -> scan_source_statuses [label="1 : N (ON DELETE RESTRICT)"];
    scan_sessions -> scan_findings [label="1 : N (ON DELETE CASCADE)"];
    source_registry -> scan_findings [label="1 : N (ON DELETE RESTRICT)"];
    scan_findings -> finding_exposed_fields [label="1 : N (ON DELETE CASCADE)"];
    scan_sessions -> scan_actions [label="1 : N (ON DELETE CASCADE)"];
}
